{
  "name": "poop-battler-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "dev:all": "./scripts/dev-all.sh",
    "build": "npm run build -w apps/web",
    "lint": "npm run lint -w apps/web && npm run lint -w packages/domain",
    "test": "npm run test -w apps/web && npm run test -w packages/domain",
    "typecheck": "npm run typecheck -w apps/web && npm run typecheck -w packages/domain",
    "db:new": "supabase migration new",
    "db:migrate": "supabase migration up",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types --local --lang typescript > packages/domain/src/types/database.types.ts",
    "db:types:check": "./scripts/check-db-types.sh",
    "db:test:rls": "./scripts/test-rls.sh",
    "prepare": "lefthook install",
    "browser:install": "agent-browser install",
    "browser:doctor": "agent-browser doctor --offline --quick"
  },
  "devDependencies": {
    "lefthook": "2.1.12"
  }
}
