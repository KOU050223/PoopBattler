{
  "name": "poop-battler",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "db:types": "supabase gen types --local --lang typescript > src/types/database.types.ts",
    "db:types:check": "./scripts/check-db-types.sh",
    "db:test:rls": "./scripts/test-rls.sh",
    "prepare": "lefthook install",
    "browser:install": "agent-browser install",
    "browser:doctor": "agent-browser doctor --offline --quick"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.5",
    "@supabase/supabase-js": "2.112.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "framer-motion": "13.1.1",
    "lucide-react": "1.39.0",
    "next": "16.3.4",
    "next-intl": "^4.14.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "agent-browser": "^0.36.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "lefthook": "2.1.12",
    "tailwindcss": "^4",
    "tw-animate-css": "1.4.0",
    "typescript": "^6",
    "vitest": "^4.1.11"
  }
}
