# Supabase 接続情報
# Supabase Dashboard > Project Settings > API から取得する。
# このファイルを `.env.local` にコピーして値を埋める（`.env.local` はコミットしない）。

# プロジェクトのURL
NEXT_PUBLIC_SUPABASE_URL=

# 公開可能キー（Publishable key / anon key）
# ブラウザへ配信されるため、RLSを有効にしたうえで利用する。
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 注意: Google OAuth の Client ID / Secret はこのファイルではなく
# `supabase/.env` に置く。あれは Supabase CLI がスタック起動時に読む
# ファイルで、Next.js が読むこのファイルとは別物（supabase/.env.example 参照）。

# 注意: Service Role Key など秘密鍵の「値」は絶対にこのファイルへ書かない。
# サーバー限定の秘密情報が必要になった場合は `NEXT_PUBLIC_` を付けない名前で
# `.env.local` にのみ設定し、Server Action / Route Handler からのみ参照する。
# 以下は変数名だけを示す雛形で、値は空のままコミットする。

# Stripe（レポート分析の課金）
# Dashboard > Developers > API keys から取得する。テストモードの鍵を使う。
# いずれも `NEXT_PUBLIC_` を付けない。ブラウザへ配信させないため。
STRIPE_SECRET_KEY=
# 販売する価格（Products > 価格 の price_... ID）
STRIPE_PRICE_ID=
# Webhook の署名シークレット。ローカルでは
# `stripe listen --forward-to localhost:3000/api/stripe/webhook` が表示する値。
STRIPE_WEBHOOK_SECRET=

# Stripe から戻ってくる先の基準URL（例: http://localhost:3000）
NEXT_PUBLIC_APP_URL=

# RLS をバイパスするサービスロールキー。Stripe の Webhook が
# subscriptions を書き込むためだけに使う。
# Supabase Dashboard > Project Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=
