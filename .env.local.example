# Supabase 接続情報
# Supabase Dashboard > Project Settings > API から取得する。
# このファイルを `.env.local` にコピーして値を埋める（`.env.local` はコミットしない）。

# プロジェクトのURL
NEXT_PUBLIC_SUPABASE_URL=

# 公開可能キー（Publishable key / anon key）
# ブラウザへ配信されるため、RLSを有効にしたうえで利用する。
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Google ログイン / アカウント連携（ローカルスタックでのみ使う）
# ---------------------------------------------------------------------------
# `supabase/config.toml` の [auth.external.google] が env() でここを読む。
# ローカルで Google の往復を試すときだけ設定し、あわせて config.toml の
# `[auth.external.google] enabled` を true にする（設定手順は supabase/README.md）。
#
# 本番の値は Dashboard へ入れる。このファイルの値はローカル専用。
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# 注意: Service Role Key など秘密鍵は絶対にこのファイルへ書かない。
# サーバー限定の秘密情報が必要になった場合は `NEXT_PUBLIC_` を付けない名前で
# `.env.local` にのみ設定し、Server Action / Route Handler からのみ参照する。
